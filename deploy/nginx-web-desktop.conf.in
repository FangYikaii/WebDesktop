# 放入 Nginx 的 http 配置上下文，仅在证书、认证文件和回源防护就绪后启用。
server {
    listen 18443 ssl;
    listen [::]:18443 ssl;
    server_name @PUBLIC_IP@;

    ssl_certificate /etc/letsencrypt/live/web-desktop-ip/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/web-desktop-ip/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:WebDesktopTLS:1m;

    auth_basic "Web Desktop";
    auth_basic_user_file /etc/nginx/web-desktop.htpasswd;
    server_tokens off;
    add_header Cache-Control "no-store" always;
    add_header X-Content-Type-Options "nosniff" always;

    access_log /var/log/nginx/web-desktop.access.log;
    error_log /var/log/nginx/web-desktop.error.log warn;

    location = / {
        rewrite ^ /vnc.html?autoconnect=1&resize=scale&reconnect=1&reconnect_delay=1500&path=websockify last;
    }

    location = /websockify {
        if ($http_origin != "https://@PUBLIC_IP@:18443") { return 403; }
        proxy_pass http://127.0.0.1:18097;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header Authorization "";
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location / {
        proxy_pass http://127.0.0.1:18097;
        proxy_http_version 1.1;
        proxy_set_header Upgrade "";
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header Authorization "";
    }
}
